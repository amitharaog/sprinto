# Copy to .env and fill in. Never commit .env.

# --- Claude (steps 2, 3, 5, 6) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- Step 4: Hunter.io (Option A). Leave blank to use contacts_manual.json (Option B / Apollo) ---
HUNTER_API_KEY=

# --- Step 7: Gmail ---
# The account the email is sent FROM (needs 2-Step Verification + an App Password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# The hardcoded TO: address - your own inbox. The pipeline never emails the prospect.
MY_EMAIL=you@gmail.com

# Signature used in the drafted emails
SENDER_NAME=Your Name
SENDER_TITLE=Growth, Sprinto
